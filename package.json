{
    "name": "cloudtak-plugin-terrain-data-downloader",
    "version": "2.0.0",
    "type": "module",
    "description": "CloudTAK plugin (admin only): download US state terrain and customizable OSM snapping data and import them as CloudTAK hosted tilesets, with default terrain/snapping options",
    "license": "AGPL-3.0-only",
    "cloudtak": {
        "minVersion": "14.4.1"
    },
    "scripts": {
        "verify": "bash verify-cloudtak.sh",
        "build:bundle": "vite build --config vite.bundle.config.ts",
        "bundle": "npm run build:bundle && node scripts/bundle.mjs"
    },
    "cloudtakBundle": {
        "name": "terrain-data-downloader",
        "author": "ValleyTacticalSolutions",
        "homepage": "https://github.com/ValleyTacticalSolutions/cloudtak-plugin-terrain-data-downloader"
    },
    "devDependencies": {
        "@tabler/icons-vue": "^3.0.0",
        "@tak-ps/vue-tabler": "^6.0.0",
        "@types/geojson": "^7946.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "maplibre-gl": "^6.16.0",
        "pinia": "^4.0.0",
        "typescript": "^5.9.0",
        "vite": "^8.0.0",
        "vite-plugin-css-injected-by-js": "^3.5.0",
        "vue": "^3.5.0",
        "vue-router": "^5.0.0"
    }
}
